# Groovebox-Ergaenzungen zur ROCKNIX-RK3326-Konfiguration
CONFIG_LOCALVERSION="-synthcity"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_INITRAMFS_SOURCE=""
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
# USB-Geraet: Audio-Interface (UAC2) + MIDI + Laufwerk + Netzwerk + serielle Konsole
CONFIG_SND_RAWMIDI=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
# USB-Host: Class-Compliant-Audio/MIDI (z. B. Roland S-1)
CONFIG_SND_USB_AUDIO=m
