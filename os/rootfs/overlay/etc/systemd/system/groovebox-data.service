[Unit]
Description=Groovebox: Datenpartition GROOVEBOX anlegen/einhaengen
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=groovebox.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/groovebox-data

[Install]
WantedBy=multi-user.target
