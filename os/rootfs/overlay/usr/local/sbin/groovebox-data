#!/bin/bash
# Datenpartition (FAT32, Name GROOVEBOX) beim ersten Start im freien Platz der Karte anlegen,
# danach bei jedem Start nach /data einhaengen. Am PC ist sie als normales Laufwerk lesbar.
set -u
LOGDIR=/data/logs
DEV=$(blkid -L GROOVEBOX 2>/dev/null || true)
ROOTDEV=$(findmnt -no SOURCE /)
ROOTDISK=/dev/$(lsblk -no PKNAME "$ROOTDEV")
# nur eine GROOVEBOX-Partition auf der Systemkarte zaehlt (nicht auf einer zweiten Karte)
case "$DEV" in "$ROOTDISK"*) ;; *) DEV=$(lsblk -lnpo NAME,LABEL "$ROOTDISK" | awk '$2=="GROOVEBOX"{print $1}' | head -1) ;; esac
if [ -z "$DEV" ]; then
    ROOT=$(findmnt -no SOURCE /)
    DISK=/dev/$(lsblk -no PKNAME "$ROOT")
    echo "Lege Datenpartition auf $DISK an"
    # hinter der letzten Partition anlegen (die Luecke vor Partition 1 gehoert dem Bootloader!)
    START=$(sfdisk -d "$DISK" | awk -F'[=,]' '/start=/{s=$2+0; z=$4+0; if (s+z>m) m=s+z} END{print m}')
    START=$(( (START + 2047) / 2048 * 2048 ))
    echo "start=$START, type=c" | sfdisk --append --no-reread --force "$DISK"
    partx -a "$DISK" 2>/dev/null || partx -u "$DISK" 2>/dev/null || true
    udevadm settle
    DEV=$(lsblk -lnpo NAME "$DISK" | tail -1)
    mkfs.vfat -F 32 -n GROOVEBOX "$DEV"
    udevadm settle
fi
mkdir -p /data
mountpoint -q /data || { fsck.vfat -a "$DEV" >/dev/null 2>&1; mount -t vfat -o rw,noatime,flush,umask=000,utf8 "$DEV" /data; }
mkdir -p /data/samples /data/projects /data/presets /data/config /data/update $LOGDIR
if [ ! -f /data/config/.defaults ]; then
    cp -rn /opt/groovebox/defaults/samples/. /data/samples/ 2>/dev/null
    touch /data/config/.defaults
fi
[ -f /data/config/groovebox.env ] || cat > /data/config/groovebox.env <<'EOF'
# Einstellungen fuer den Groovebox-Start (Zeilen ohne # gelten)
# GB_DISPLAY=drm   -> Bild direkt per CPU (Standard, ohne GPU)
# GB_DISPLAY=sdl   -> Bild ueber SDL/GPU (Panfrost), zum Testen
# PAN_MESA_DEBUG=noafbc
# GB_DRM_FLIP=1   -> Puffer-Wechsel (Page-Flip) statt einem Bildspeicher, zum Testen
EOF
sync
